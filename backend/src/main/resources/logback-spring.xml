<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging config. Rule: NEVER log personal data (names, emails, phones, addresses,
  passwords, tokens). Log IDs instead. %maskedMsg is only a safety net.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <conversionRule conversionWord="maskedMsg"
                    class="com.swiftdrop.common.logging.PiiMaskingConverter"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%15.15t] %-40.40logger{39} : %maskedMsg%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
