# SwiftDrop environment variables.
#   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials. The values below are
# local-development placeholders only; change them for any shared environment.

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_local_dev
# Used when running the backend on your machine. Docker Compose overrides the host to "postgres".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swiftdrop

# ---------- RabbitMQ ----------
# Docker Compose overrides the host to "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=swiftdrop_local_dev

# ---------- Auth ----------
# At least 32 characters. Generate your own: openssl rand -base64 48
JWT_SECRET=local-dev-only-jwt-secret-replace-me-0123456789
# Access token lifetime in seconds
JWT_EXPIRY=3600
# Google OAuth. Leave commented out until you have credentials from Google Cloud Console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------- Mail ----------
# Defaults point at a local SMTP catcher (e.g. Mailpit on 1025); not part of the stack yet.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@swiftdrop.local

# ---------- Frontend ----------
# Allowed CORS origin(s) for the backend, comma-separated.
FRONTEND_URL=http://localhost:5173,http://localhost:3000
FRONTEND_PORT=3000
# Shows the temporary "sign in as role" buttons in the Docker build. Set false before any real deployment.
VITE_ENABLE_DEV_LOGIN=true
