# SwiftDrop environment variables.
#   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials. The values below are
# local-development placeholders only; change them for any shared environment.

# ---------- Spring ----------
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080

# ---------- PostgreSQL ----------
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_local_dev
# Used when running the backend on your machine. Docker Compose overrides the host to "postgres".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swiftdrop

# ---------- RabbitMQ ----------
# Docker Compose overrides the host to "rabbitmq".
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=swiftdrop_local_dev

# ---------- Redis ----------
# Sign-in sessions, rate limits and cooldowns. Docker Compose overrides the host to "redis".
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=swiftdrop_local_dev

# ---------- Auth ----------
# At least 32 characters. Generate your own: openssl rand -base64 48
JWT_SECRET=local-dev-only-jwt-secret-replace-me-0123456789
# Access token lifetime in seconds (renewed silently with the httpOnly session cookie)
JWT_EXPIRY=900
# Session cookie: Secure (HTTPS only). Browsers allow it on http://localhost; set false only
# when serving over plain HTTP from another host name.
AUTH_COOKIE_SECURE=true
# Per-IP and failed-sign-in limits on /api/v1/auth (keep true outside load tests)
RATE_LIMIT_ENABLED=true
# Password reset link lifetime in seconds
PASSWORD_RESET_EXPIRY=1800
# Minimum seconds between two reset emails to the same address
PASSWORD_RESET_RESEND_COOLDOWN=60
# Sign-in session length in seconds: with "Remember me" (30 days, renewed on use) and without (1 day max)
REFRESH_TOKEN_EXPIRY_REMEMBER_ME=2592000
REFRESH_TOKEN_EXPIRY_SESSION=86400
# The one SwiftDrop admin (DISPATCHER_ADMIN). Required: the backend won't start without them.
# On every startup the admin account is created or updated to match these values, so to change the
# admin's email or password, change them here and restart. Sign in at /admin/login.
ADMIN_EMAIL=admin@swiftdrop.local
ADMIN_PASSWORD=change-me-admin-2026
ADMIN_FULL_NAME=SwiftDrop Admin
# Sign in with Google: the OAuth 2.0 Client ID (type "Web application") from Google Cloud Console,
# with http://localhost:3000 and http://localhost:5173 as Authorized JavaScript origins.
# Public (not a secret); no client secret is needed. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# ---------- Mail (SMTP) ----------
# Gmail (used for password reset and merchant approval emails):
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Google Account > Security > App passwords: create one called "SwiftDrop".
#   3. Paste the 16 characters into MAIL_PASSWORD WITHOUT spaces.
# MAIL_USERNAME and MAIL_FROM must be the same Gmail address. Never commit the real password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=SwiftDrop
# Local testing without Gmail: Mailpit catches every email at http://localhost:8025. Use
#   MAIL_HOST=mailpit (Docker) or localhost (backend on your machine), MAIL_PORT=1025,
#   MAIL_SMTP_AUTH=false, MAIL_STARTTLS=false and leave MAIL_USERNAME / MAIL_PASSWORD empty.

# ---------- Frontend ----------
# Allowed CORS origin(s) for the backend, comma-separated.
FRONTEND_URL=http://localhost:5173,http://localhost:3000
# Web app address used in email links (password reset, merchant approval).
FRONTEND_BASE_URL=http://localhost:3000
FRONTEND_PORT=3000
# Sample tracking data in the browser until the tracking API exists (auth always uses the backend).
VITE_USE_MOCK_API=true
