# Copy to .env.local for local overrides (never commit real values).
# Base URL of the backend API. Relative by default so the Vite dev proxy / Nginx handles it.
VITE_API_BASE_URL=/api/v1
# Where the Vite dev server proxies /api requests (local dev only).
VITE_PROXY_TARGET=http://localhost:8080
# Use the in-browser mock API (demo sign-in + sample tracking). Defaults to true in `npm run dev`.
VITE_USE_MOCK_API=true
